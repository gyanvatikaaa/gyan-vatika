# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database (MongoDB Atlas free tier) ----
# Get this from: https://www.mongodb.com/cloud/atlas -> Create free cluster -> Connect -> Drivers
MONGO_URI=your_mongodb_atlas_connection_string_here

# ---- Auth ----
# Any long random string. You can generate one at https://randomkeygen.com
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Admin (auto-created & auto-approved on first server start) ----
ADMIN_NAME=Gyan Vatika Admin
ADMIN_EMAIL=gyanvatikaaa@gmail.com
ADMIN_PASSWORD=set_a_strong_password_here
ADMIN_WHATSAPP=9893161971

# ---- AI (Google Gemini free tier) ----
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Photo uploads for handwritten answers (Cloudinary free tier) ----
# Get from: https://cloudinary.com/users/register/free -> Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Email notifications (Gmail free) ----
# Use a Gmail "App Password", not your normal password:
# https://myaccount.google.com/apppasswords
EMAIL_USER=gyanvatikaaa@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
